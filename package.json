{
  "name": "shopilot",
  "version": "0.4.40",
  "description": "ShopPilot - 电商店铺浏览器工作台",
  "private": true,
  "main": "apps/desktop/out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "release:manifest": "node tools/release/release-manifest.js",
    "release:publish": "node tools/release/publish-release.js",
    "release:full": "pnpm run dist && node tools/release/release-manifest.js && node tools/release/publish-release.js",
    "lint": "eslint .",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "electron-updater": "6.8.9",
    "pino": "8.19.0",
    "pino-pretty": "11.0.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.9",
    "@types/node": "20.11.24",
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/eslint-config-typescript": "13.0.0",
    "electron": "30.5.1",
    "electron-builder": "24.13.3",
    "electron-vite": "2.0.0",
    "eslint": "8.57.0",
    "eslint-plugin-vue": "9.22.0",
    "pinia": "2.1.7",
    "playwright": "1.42.1",
    "typescript": "5.3.3",
    "vite": "5.1.4",
    "vitest": "1.3.1",
    "vue": "3.4.21",
    "vue-router": "4.3.0",
    "vue-tsc": "1.8.27"
  }
}
