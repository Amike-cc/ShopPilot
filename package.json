{
  "name": "shopilot",
  "version": "0.6.0",
  "description": "ShopPilot - 电商店铺浏览器工作台",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "http-cache-semantics": "4.3.0",
      "builder-util-runtime": "9.7.0",
      "brace-expansion@^1.1.7": "1.1.21",
      "brace-expansion@^2.0.1": "2.1.7",
      "brace-expansion@^2.0.2": "2.1.7",
      "source-map-js": "1.2.2"
    }
  },
  "main": "apps/desktop/out/main/index.js",
  "scripts": {
    "postinstall": "node tools/maintenance/postinstall-native.mjs",
    "rebuild:native": "node tools/maintenance/postinstall-native.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "dist:acceptance": "node tools/acceptance/build-acceptance.mjs",
    "release:manifest": "node tools/release/release-manifest.js",
    "release:publish": "node tools/release/publish-release.js",
    "release:full": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run dist && node tools/release/release-manifest.js && node tools/release/publish-release.js",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 1145",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:custom-local": "node tools/acceptance/custom-task-local-verify.js",
    "test:maintenance-local": "node tools/acceptance/maintenance-cache-local-verify.js",
    "test:invite-douyin-local": "node tools/acceptance/douyin-invite-local-verify.js",
    "test:customer-service-switch": "node tools/acceptance/customer-service-switch-local-verify.js",
    "test:invite-live-log": "node tools/acceptance/invite-live-log-verify.js",
    "test:invite-v2-smoke": "node tools/acceptance/creator-invite-smoke.js",
    "test:custom-realclick": "node tools/acceptance/custom-task-real-click-verify.js",
    "test:webview-attach": "node tools/acceptance/webview-attach-local-verify.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "13.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.6",
    "pinia": "2.3.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
