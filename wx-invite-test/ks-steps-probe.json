[
 {
  "type": "loop",
  "input": {
   "label": "个护家清/纸品湿巾 · 每批 2 位",
   "maxRounds": 20,
   "stopOn": [
    "TASK_QUOTA_EXCEEDED",
    "TASK_SELECTION_SHORTFALL"
   ],
   "steps": [
    {
     "type": "navigate",
     "input": {
      "url": "https://cps.kwaixiaodian.com/zone/daren-match/daren-square-pro"
     },
     "timeoutMs": 45000
    },
    {
     "type": "waitForPage",
     "input": {
      "urlIncludes": "daren-square-pro"
     },
     "timeoutMs": 45000
    },
    {
     "type": "clickByText",
     "input": {
      "text": "个护家清",
      "within": {
       "text": "带货类目",
       "climb": 2
      }
     },
     "timeoutMs": 20000
    },
    {
     "type": "clickByText",
     "input": {
      "text": "纸品湿巾",
      "within": {
       "selector": ".kwaishop-cps-daren-match-pc-select-dropdown"
      },
      "mode": "real"
     },
     "timeoutMs": 25000
    },
    {
     "type": "pressKey",
     "input": {
      "key": "Escape"
     },
     "timeoutMs": 10000
    },
    {
     "type": "clickByText",
     "input": {
      "text": "美妆",
      "within": {
       "text": "内容标签",
       "climb": 2
      }
     },
     "timeoutMs": 20000
    },
    {
     "type": "clickByText",
     "input": {
      "text": "有联系方式",
      "within": {
       "text": "合作信息",
       "climb": 2
      }
     },
     "timeoutMs": 20000
    },
    {
     "type": "waitForSelector",
     "input": {
      "selector": "tbody input[type=checkbox]"
     },
     "timeoutMs": 30000
    },
    {
     "type": "waitForText",
     "input": {
      "text": "个护家清",
      "within": {
       "selector": ".kwaishop-cps-daren-match-pc-pro-tagForm-result"
      }
     },
     "timeoutMs": 25000
    },
    {
     "type": "waitForText",
     "input": {
      "text": "纸品湿巾",
      "within": {
       "selector": ".kwaishop-cps-daren-match-pc-pro-tagForm-result"
      }
     },
     "timeoutMs": 25000
    },
    {
     "type": "clickAll",
     "input": {
      "selector": "tbody input[type=checkbox]",
      "max": 2,
      "scroll": true,
      "maxRounds": 40,
      "counterIncludes": "已选"
     },
     "timeoutMs": 240000
    },
    {
     "type": "clickByText",
     "input": {
      "text": "批量邀约"
     }
    },
    {
     "type": "waitForSelector",
     "input": {
      "selector": "textarea"
     },
     "timeoutMs": 30000
    },
    {
     "type": "requireQuota",
     "input": {
      "textIncludes": "今日剩余",
      "min": 1,
      "optional": false,
      "hint": "快手抽屉底部明示「今日剩余N条发送邀请机会」，额度为 0 时如实停止（不会硬发）"
     },
     "timeoutMs": 30000
    },
    {
     "type": "setInput",
     "input": {
      "selector": "input[placeholder*=\"常用联系人称呼\"]",
      "text": "刘涛"
     },
     "timeoutMs": 20000
    },
    {
     "type": "setInput",
     "input": {
      "selector": "input[placeholder*=\"常用11位手机号\"]",
      "text": "13148070563"
     },
     "timeoutMs": 20000
    },
    {
     "type": "setInput",
     "input": {
      "selector": "input[placeholder*=\"常用微信号\"]",
      "text": "amike688"
     },
     "timeoutMs": 20000
    },
    {
     "type": "setInput",
     "input": {
      "selector": "textarea",
      "text": "您好，我们是做大促家清用品的工厂店，想邀请您合作带货：给专属高佣与免费寄样，素材我们提供、发货售后全包，价格可谈。"
     }
    },
    {
     "type": "screenshot",
     "input": {},
     "timeoutMs": 20000
    },
    {
     "type": "clickByText",
     "input": {
      "text": "选择商品"
     },
     "timeoutMs": 20000
    },
    {
     "type": "waitForSelector",
     "input": {
      "selector": ".kwaishop-cps-daren-match-pc-modal-body tbody input[type=checkbox]"
     },
     "timeoutMs": 30000
    },
    {
     "type": "clickAll",
     "input": {
      "selector": ".kwaishop-cps-daren-match-pc-modal-body tbody input[type=checkbox]",
      "max": 1,
      "skipSelector": ".kwaishop-cps-daren-match-pc-modal-body thead input[type=checkbox]"
     },
     "timeoutMs": 60000
    },
    {
     "type": "clickByText",
     "input": {
      "text": "确 认"
     },
     "timeoutMs": 20000
    },
    {
     "type": "clickIfPresent",
     "input": {
      "text": "确认",
      "nearText": "确认是否仍要发送邀请",
      "waitMs": 8000
     },
     "timeoutMs": 22000
    },
    {
     "type": "requireQuota",
     "input": {
      "textIncludes": "已选择商品数",
      "min": 1,
      "code": "TASK_PRODUCT_NOT_SELECTED",
      "hint": "邀约商品没选上——平台要求必选商品才能发送，已在发送前中止"
     },
     "timeoutMs": 30000
    },
    {
     "type": "screenshot",
     "input": {},
     "timeoutMs": 20000
    },
    {
     "type": "clickByText",
     "input": {
      "text": "可聊高佣"
     }
    },
    {
     "type": "clickByText",
     "input": {
      "text": "发送邀请"
     }
    },
    {
     "type": "waitForGone",
     "input": {
      "selector": "textarea"
     },
     "timeoutMs": 180000
    },
    {
     "type": "screenshot",
     "input": {},
     "timeoutMs": 20000
    }
   ]
  }
 }
]